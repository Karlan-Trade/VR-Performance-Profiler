// Settings Dialog Resource
#include <windows.h>

#define IDD_SETTINGS 2001

#define IDC_RADIO_HUD       2010
#define IDC_RADIO_WRIST     2011
#define IDC_CHECK_CPU_LOAD  2020
#define IDC_CHECK_CPU_TEMP  2021
#define IDC_CHECK_GPU_LOAD  2022
#define IDC_CHECK_GPU_TEMP  2023
#define IDC_CHECK_GPU_MEM   2024
#define IDC_CHECK_RAM       2025
#define IDC_COMBO_THEME     2030
#define IDC_COMBO_LANGUAGE  2031
#define IDC_COMBO_INTERVAL  2032
#define IDC_BTN_APPLY       2040
#define IDC_BTN_CANCEL      2041
#define IDC_INFO_TEXT       2050
#define IDC_GROUP_OVERLAY   2060
#define IDC_GROUP_METRICS   2061
#define IDC_GROUP_APPEAR    2062
#define IDC_GROUP_DATA      2063
#define IDC_LABEL_THEME     2070
#define IDC_LABEL_LANGUAGE  2071
#define IDC_LABEL_INTERVAL  2072
#define IDC_STATIC          -1

IDD_SETTINGS DIALOGEX 0, 0, 560, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VR Performance Profiler - Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Overlay Mode", IDC_GROUP_OVERLAY, 10, 10, 175, 55
    AUTORADIOBUTTON "HUD (Head-locked)", IDC_RADIO_HUD, 20, 25, 150, 15, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Wrist (Controller)", IDC_RADIO_WRIST, 20, 45, 150, 15

    GROUPBOX        "Metrics", IDC_GROUP_METRICS, 10, 75, 175, 140
    AUTOCHECKBOX    "CPU Load", IDC_CHECK_CPU_LOAD, 20, 90, 130, 12
    AUTOCHECKBOX    "CPU Temp", IDC_CHECK_CPU_TEMP, 20, 108, 130, 12
    AUTOCHECKBOX    "GPU Load", IDC_CHECK_GPU_LOAD, 20, 126, 130, 12
    AUTOCHECKBOX    "GPU Temp", IDC_CHECK_GPU_TEMP, 20, 144, 130, 12
    AUTOCHECKBOX    "VRAM",     IDC_CHECK_GPU_MEM,  20, 162, 130, 12
    AUTOCHECKBOX    "RAM",      IDC_CHECK_RAM,      20, 180, 130, 12

    GROUPBOX        "Appearance", IDC_GROUP_APPEAR, 10, 225, 175, 70
    LTEXT           "Theme:", IDC_LABEL_THEME, 20, 242, 55, 10
    COMBOBOX        IDC_COMBO_THEME, 85, 238, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Language:", IDC_LABEL_LANGUAGE, 20, 265, 55, 10
    COMBOBOX        IDC_COMBO_LANGUAGE, 85, 261, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Live Data", IDC_GROUP_DATA, 200, 10, 350, 285
    LTEXT           "Update:", IDC_LABEL_INTERVAL, 215, 27, 55, 10
    COMBOBOX        IDC_COMBO_INTERVAL, 275, 23, 90, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_INFO_TEXT, 215, 47, 320, 230, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    DEFPUSHBUTTON   "Apply",  IDC_BTN_APPLY,  425, 305, 60, 15
    PUSHBUTTON      "Cancel", IDC_BTN_CANCEL, 490, 305, 60, 15
END
